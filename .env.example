# Скопируйте в .env и вставьте токен из BotFather. Не добавляйте .env в Git.
BOT_TOKEN=
# Путь относительно текущей рабочей папки; запускайте из корня репозитория.
DATABASE_URL=sqlite+aiosqlite:///./data/labdefender.sqlite3
LOG_LEVEL=INFO
# Пустое значение отключает регистрацию по коду. Передавайте код только преподавателям.
TEACHER_REGISTRATION_CODE=
# JSON-массив Telegram ID администраторов (не username). Пример: [123456789,987654321]
ADMIN_IDS=[]
