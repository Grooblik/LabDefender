# Скопируйте в .env и вставьте токен из BotFather. Не добавляйте .env в Git.
BOT_TOKEN=
# Путь относительно текущей рабочей папки; запускайте из корня репозитория.
DATABASE_URL=sqlite+aiosqlite:///./data/labdefender.sqlite3
LOG_LEVEL=INFO
# Пустое значение отключает регистрацию по коду. Передавайте код только преподавателям.
TEACHER_REGISTRATION_CODE=
# JSON-массив Telegram ID администраторов (не username). Пример: [123456789,987654321]
ADMIN_IDS=[]
# Mini App: публичный адрес https:// без / в конце. Пусто — Mini App выключена.
# Для временного адреса оставьте пустым и запускайте scripts/run.sh --tunnel (run.ps1 -Tunnel).
# Для постоянного — адрес из Cloudflare вместе с TUNNEL_TOKEN ниже.
WEBAPP_URL=
# Токен туннеля Cloudflare с постоянным адресом (секрет, как BOT_TOKEN). С ним --tunnel
# поднимает этот туннель на WEBAPP_URL. Пусто — --tunnel даёт временный адрес.
TUNNEL_TOKEN=
# Локальный адрес веб-сервера Mini App; наружу его открывает туннель или прокси.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Сколько секунд принимать данные входа Telegram (initData) после открытия приложения.
WEBAPP_AUTH_MAX_AGE=86400
